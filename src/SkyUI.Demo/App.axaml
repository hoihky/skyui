<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SkyUI.Demo.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SkyUI.Themes.Sky/Themes/Sky/SkyTheme.axaml" />
        <StyleInclude Source="avares://SkyUI.Data/Themes/SkyDataTheme.axaml" />
    </Application.Styles>
</Application>
