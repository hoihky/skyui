<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sky="https://skyui.dev"
             x:Class="SkyUI.Demo.Views.Demos.PlaceholderDemo">
    <Border Classes="sky-demo-panel">
        <StackPanel Spacing="12">
            <TextBlock Classes="sky-feature-heading" Text="SkyPlaceholderControl" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SkyTextSecondaryBrush}"
                       Text="Sample control from the SkyUI library (not MUI-themed)." />
            <sky:SkyPlaceholderControl Width="280" Height="96"
                Background="{DynamicResource SkyAccentBrush}" />
        </StackPanel>
    </Border>
</UserControl>
