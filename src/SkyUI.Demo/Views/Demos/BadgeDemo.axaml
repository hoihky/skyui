<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sky="https://skyui.dev"
             x:Class="SkyUI.Demo.Views.Demos.BadgeDemo">
    <Border Classes="sky-demo-panel">
        <StackPanel Spacing="16">
            <TextBlock Classes="sky-feature-heading" Text="Badge" />
            <StackPanel Orientation="Horizontal" Spacing="24">
                <sky:Badge BadgeContent="4">
                    <Button Classes="sky" Content="Mail" />
                </sky:Badge>
                <sky:Badge BadgeContent="99" BadgeBackground="{DynamicResource SkyTextSecondaryBrush}">
                    <Border Width="40" Height="40" Background="#E0E0E0" CornerRadius="20" />
                </sky:Badge>
                <sky:Badge IsDot="True">
                    <Button Classes="sky sky-outlined" Content="Alerts" />
                </sky:Badge>
                <sky:Badge BadgeContent="7" Placement="BottomLeft">
                    <Border Width="40" Height="40" Background="#E3F2FD" CornerRadius="4" />
                </sky:Badge>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
