<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sky="https://skyui.dev"
             x:Class="SkyUI.Demo.Views.Demos.ChipDemo">
    <Border Classes="sky-demo-panel">
        <StackPanel Spacing="16">
            <TextBlock Classes="sky-feature-heading" Text="Chip" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12">
                <sky:Chip Label="Default" />
                <sky:Chip Label="Outlined" Variant="Outlined" />
                <sky:Chip Label="Deletable" IsDeletable="True" />
                <sky:Chip Label="Alice" IsClickable="True">
                    <sky:Chip.AvatarContent>
                        <sky:Avatar DisplayName="Alice" Size="24" />
                    </sky:Chip.AvatarContent>
                </sky:Chip>
                <sky:Chip Label="Team" Variant="Outlined" Size="Small" IsDeletable="True">
                    <sky:Chip.AvatarContent>
                        <sky:Avatar Initials="T" Size="22" Background="{DynamicResource SkyAccentBrush}" />
                    </sky:Chip.AvatarContent>
                </sky:Chip>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
