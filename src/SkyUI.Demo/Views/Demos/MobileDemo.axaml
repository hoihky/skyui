<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sky="https://skyui.dev"
             xmlns:vm="using:SkyUI.Demo.ViewModels"
             x:Class="SkyUI.Demo.Views.Demos.MobileDemo"
             x:DataType="vm:MobileDemoViewModel">
  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Border Classes="sky-demo-panel" Margin="0,0,0,80">
        <StackPanel Spacing="20">
          <TextBlock Classes="sky-feature-heading" Text="Mobile primitives" />
          <TextBlock Classes="sky-body-secondary"
                     TextWrapping="Wrap"
                     Text="Safe area, touch targets, sheets, keyboard inset, FAB, and pull-to-refresh. Bindings below use MobileDemoViewModel." />

          <TextBlock Classes="sky-body-secondary" Text="{Binding Status}" TextWrapping="Wrap" />

          <StackPanel Spacing="8">
            <TextBlock Classes="sky-section-title" Text="SkyPullToRefresh" />
            <TextBlock Classes="sky-body-secondary"
                       TextWrapping="Wrap"
                       Text="Wrap a ScrollViewer; bind IsRefreshing and RefreshCommand from your view model." />
            <Border BorderBrush="{DynamicResource SkyBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Height="280"
                    ClipToBounds="True">
              <sky:SkyPullToRefresh IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                                    RefreshCommand="{Binding RefreshCommand}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Items}" Margin="12">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="sky-card" Margin="0,0,0,8" Padding="12">
                          <TextBlock Text="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </sky:SkyPullToRefresh>
            </Border>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="sky-section-title" Text="SkyFab" />
            <Button Classes="sky sky-outlined"
                    Content="Toggle extended FAB"
                    Command="{Binding ToggleFabCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Classes="sky-body-secondary"
                       TextWrapping="Wrap"
                       Text="FAB floats above content (bottom-right) with optional safe-area margin." />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="sky-section-title" Text="SkySafeArea" />
            <Border BorderBrush="{DynamicResource SkyBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Height="100"
                    ClipToBounds="True">
              <sky:SkySafeArea Background="{DynamicResource SkySurfaceElevatedBrush}">
                <TextBlock Margin="8"
                           VerticalAlignment="Center"
                           Text="Content inside SkySafeArea."
                           TextWrapping="Wrap" />
              </sky:SkySafeArea>
            </Border>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="sky-section-title" Text="SkyTouchTarget" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <Button x:Name="SmallButton" Classes="sky sky-subtle" Content="Small (32px)" Padding="8,4" />
              <Button x:Name="TouchButton" Classes="sky sky-primary" Content="Ensured 44pt target" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="sky-section-title" Text="SkyActionSheet" />
            <Button x:Name="ActionSheetButton" Classes="sky sky-outlined" Content="Show action sheet" HorizontalAlignment="Left" />
            <TextBlock x:Name="ActionSheetResult" Classes="sky-body-secondary" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="sky-section-title" Text="SkySheetHost" />
            <Button x:Name="SheetButton" Classes="sky sky-outlined" Content="Open filter sheet" HorizontalAlignment="Left" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="sky-section-title" Text="SkyKeyboardInset" />
            <Border BorderBrush="{DynamicResource SkyBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Height="180"
                    ClipToBounds="True">
              <sky:SkyKeyboardInset>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="12" Margin="12">
                    <sky:SkyFormField Label="Notes">
                      <TextBox Classes="sky" PlaceholderText="Keyboard inset demo" />
                    </sky:SkyFormField>
                  </StackPanel>
                </ScrollViewer>
              </sky:SkyKeyboardInset>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <sky:SkyFab Icon="Add"
                Label="{Binding FabLabel}"
                IsExtended="{Binding IsExtendedFab}"
                Command="{Binding AddItemCommand}" />

    <sky:SkySheetHost x:Name="SheetHost" />
  </Grid>
</UserControl>
