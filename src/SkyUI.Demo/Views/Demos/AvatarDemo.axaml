<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sky="https://skyui.dev"
             x:Class="SkyUI.Demo.Views.Demos.AvatarDemo">
    <Border Classes="sky-demo-panel">
        <StackPanel Spacing="16">
            <TextBlock Classes="sky-feature-heading" Text="Avatar" />
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <sky:Avatar DisplayName="Jane Doe" />
                <sky:Avatar Size="48" Initials="AB" Background="{DynamicResource SkyAccentBrush}" />
                <sky:Avatar Size="56" DisplayName="Sky UI" Background="{DynamicResource SkyTextSecondaryBrush}" />
                <sky:Avatar Size="40" IsCircular="False" CornerRadius="8" DisplayName="Rounded" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
