<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SkyUI.Demo.Views.Demos.CheckboxSwitchDemo">
    <Border Classes="sky-demo-panel">
        <StackPanel Spacing="16">
            <TextBlock Classes="sky-feature-heading" Text="Checkbox &amp; switch" />
            <StackPanel Spacing="12">
                <CheckBox Classes="sky" Content="Remember me" IsChecked="True" />
                <CheckBox Classes="sky" Content="Subscribe to updates" />
                <ToggleSwitch Classes="sky" OnContent="On" OffContent="Off" IsChecked="True" />
                <ToggleSwitch Classes="sky" OnContent="On" OffContent="Off" IsChecked="False" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
