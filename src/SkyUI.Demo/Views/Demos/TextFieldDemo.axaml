<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SkyUI.Demo.Views.Demos.TextFieldDemo">
    <Border Classes="sky-demo-panel">
        <StackPanel Spacing="16">
            <TextBlock Classes="sky-feature-heading" Text="Text field" />
            <TextBox Classes="sky" Watermark="Outlined field" Text="" Width="320" HorizontalAlignment="Left" />
        </StackPanel>
    </Border>
</UserControl>
