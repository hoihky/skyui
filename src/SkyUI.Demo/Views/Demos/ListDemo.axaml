<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:SkyUI.Icons"
             x:Class="SkyUI.Demo.Views.Demos.ListDemo">
    <Border Classes="sky-demo-panel">
        <StackPanel Spacing="16">
            <TextBlock Classes="sky-feature-heading" Text="List" />
            <ListBox Classes="sky" Height="160" Width="320" HorizontalAlignment="Left" SelectedIndex="0">
                <ListBoxItem Content="List item one" icons:SkyIconProperties.Icon="List" icons:SkyIconProperties.IconChrome="ListItem" />
                <ListBoxItem Content="List item two" icons:SkyIconProperties.Icon="Check" icons:SkyIconProperties.IconChrome="ListItem" />
                <ListBoxItem Content="List item three" icons:SkyIconProperties.Icon="Settings" icons:SkyIconProperties.IconChrome="ListItem" />
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
