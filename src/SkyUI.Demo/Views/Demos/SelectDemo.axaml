<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SkyUI.Demo.Views.Demos.SelectDemo">
    <Border Classes="sky-demo-panel">
        <StackPanel Spacing="16">
            <TextBlock Classes="sky-feature-heading" Text="Select (dropdown)" />
            <ComboBox Classes="sky" Width="320" HorizontalAlignment="Left" SelectedIndex="0">
                <ComboBoxItem Content="Option one" />
                <ComboBoxItem Content="Option two" />
                <ComboBoxItem Content="Option three" />
            </ComboBox>
        </StackPanel>
    </Border>
</UserControl>
