<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sky="using:SkyUI.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="SkyUI.Demo.Views.Demos.VideoTimelineDemo">
  <StackPanel Spacing="16">
    <TextBlock Classes="sky-section-title" Text="Video timeline" />
    <TextBlock Classes="sky-body-secondary"
               TextWrapping="Wrap"
               Text="Scroll the ruler and track area; Ctrl+wheel zooms. Click a track lane or label to highlight it. Drag clip edges to trim; drag the body to move (multi-selected clips move together). Ctrl+drag on a lane for marquee clip select. Double-tap a lane for a marker. Shift+click for multi-select. Split at playhead, Undo/Redo (Ctrl+Z / Ctrl+Y). Toggle snap below." />

    <WrapPanel Orientation="Horizontal">
      <Button Classes="sky sky-primary" Content="Play" Click="OnPlayClick" Margin="0,0,8,8" />
      <Button Classes="sky" Content="Stop" Click="OnStopClick" Margin="0,0,8,8" />
      <Button Classes="sky" Content="Add track" Click="OnAddTrackClick" Margin="0,0,8,8" />
      <Button Classes="sky" Content="Add clip at playhead" Click="OnAddClipClick" Margin="0,0,8,8" />
      <Button Classes="sky" Content="Split at playhead" Click="OnSplitClick" Margin="0,0,8,8" />
      <Button Classes="sky" Content="Undo" Click="OnUndoClick" Margin="0,0,8,8" />
      <Button Classes="sky" Content="Redo" Click="OnRedoClick" Margin="0,0,8,8" />
      <Button Classes="sky" Content="Remove selected clip" Click="OnRemoveClipClick" Margin="0,0,8,8" />
      <Button Classes="sky" Content="Remove selected track" Click="OnRemoveTrackClick" Margin="0,0,8,8" />
    </WrapPanel>

    <CheckBox x:Name="SnapToggle"
              Classes="sky"
              Content="Magnetic snap"
              IsChecked="True"
              IsCheckedChanged="OnSnapToggleChanged" />

    <Border Classes="sky-card" Padding="12">
      <sky:VideoTimeline x:Name="Timeline"
                         Height="320"
                         Duration="90"
                         PixelsPerSecond="48" />
    </Border>

    <TextBlock Classes="sky-feature-heading" Text="Event log" />
    <ListBox x:Name="Log"
             Classes="sky"
             MinHeight="120"
             MaxHeight="200" />
  </StackPanel>
</UserControl>
