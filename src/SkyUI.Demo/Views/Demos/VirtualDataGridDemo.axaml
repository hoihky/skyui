<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sky="https://skyui.dev"
             x:Class="SkyUI.Demo.Views.Demos.VirtualDataGridDemo">
    <Border Classes="sky-demo-panel">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <StackPanel Spacing="6">
                <TextBlock Classes="sky-feature-heading" Text="SkyVirtualDataGrid" />
                <TextBlock TextWrapping="Wrap" MaxWidth="900"
                           Foreground="{DynamicResource SkyTextSecondaryBrush}"
                           Text="Demo uses row virtualization (default) with 50,000 rows — scroll to verify tail rows. Set EnableRowVirtualization=false to materialize every row (heavy for large n). Sort / drag / edit / export as before." />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ExportCsvButton" Classes="sky sky-outlined" Content="Export first 10k CSV" />
                <Button x:Name="CopySelectionButton" Classes="sky sky-outlined" Content="Copy selected row" />
                <Button x:Name="BumpButton" Classes="sky sky-outlined" Content="Bump row 0 (background)" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{DynamicResource SkyTextSecondaryBrush}" />
            </StackPanel>
            <sky:SkyVirtualDataGrid x:Name="Grid"
                                    Grid.Row="2"
                                    MinHeight="320"
                                    EnableRowVirtualization="True" />
        </Grid>
    </Border>
</UserControl>
