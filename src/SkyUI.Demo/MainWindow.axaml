<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:SkyUI.Demo.Models"
        xmlns:icons="using:SkyUI.Icons"
        xmlns:views="using:SkyUI.Demo.Views"
        xmlns:sky="https://skyui.dev"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
        x:Class="SkyUI.Demo.MainWindow"
        Title="SkyUI demo"
        Width="980" Height="680"
        MinWidth="640" MinHeight="480"
        Background="{DynamicResource SkyBackgroundBrush}"
        FontFamily="{DynamicResource SkyFontFamilyUi}">
    <Panel>
        <Grid ColumnDefinitions="240,*">
            <Border Grid.Column="0"
                    Background="{DynamicResource SkySurfaceBrush}"
                    BorderBrush="{DynamicResource SkyBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto"
                          Margin="12,12,12,8">
                        <TextBlock Grid.Column="0"
                                   Text="Components"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SkyTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="sky sky-subtle"
                                Padding="8"
                                ToolTip.Tip="Appearance"
                                Click="OnOpenSettingsDrawer">
                            <icons:SkyIcon Kind="Settings" Size="Medium" />
                        </Button>
                    </Grid>
                    <ListBox x:Name="NavList"
                             Classes="sky sky-nav"
                             Margin="8,0,8,12"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:DemoItem">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <icons:SkyIcon Kind="{Binding Icon}"
                                                   Size="Medium"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}"
                                               Classes="sky-nav-link"
                                               Padding="0,2"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource SkyBackgroundBrush}">
                <ContentControl x:Name="DetailHost"
                                Padding="28,24"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Top" />
            </ScrollViewer>
        </Grid>

        <sky:SkyDrawer x:Name="SettingsDrawer"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Title="Appearance"
                       Placement="Right"
                       DrawerWidth="300">
            <sky:SkyDrawer.DrawerContent>
                <views:AppearanceSettingsPanel />
            </sky:SkyDrawer.DrawerContent>
        </sky:SkyDrawer>
    </Panel>
</Window>
