<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:SkyUI.Icons">
  <!-- Sky ContentFirstDark preset — primitives on semantic tokens; legacy "spotify" style classes alias "sky". -->
  <!-- Dark pill (secondary) -->
  <Style Selector="Button.sky, Button.spotify">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="{DynamicResource SkyDensityButtonPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusFull}" />
    <Setter Property="MinHeight" Value="{DynamicResource SkyDensityButtonMinHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource SkyFontSizeButton}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFamily" Value="{DynamicResource SkyFontFamilyUi}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.sky:pointerover, Button.spotify:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkyCardMidBrush}" />
  </Style>
  <Style Selector="Button.sky:pressed, Button.spotify:pressed">
    <Setter Property="Background" Value="{DynamicResource SkyCardBrush}" />
  </Style>

  <!-- Primary CTA (accent) (functional accent) -->
  <Style Selector="Button.sky.sky-primary, Button.spotify.spotify-primary">
    <Setter Property="Background" Value="{DynamicResource SkyAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyOnAccentBrush}" />
  </Style>
  <Style Selector="Button.sky.sky-primary:pointerover, Button.spotify.spotify-primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkyAccentPressedBrush}" />
  </Style>
  <Style Selector="Button.sky.sky-primary:pressed, Button.spotify.spotify-primary:pressed">
    <Setter Property="Background" Value="{DynamicResource SkyAccentPressedBrush}" />
  </Style>

  <!-- Large nav pill -->
  <Style Selector="Button.sky.sky-nav-pill, Button.spotify.spotify-nav-pill">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="Padding" Value="{DynamicResource SkyDensityNavPillPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource SkyDensityNavPillMinHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusPill}" />
  </Style>
  <Style Selector="Button.sky.sky-nav-pill:pointerover, Button.spotify.spotify-nav-pill:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceElevatedBrush}" />
  </Style>

  <!-- Outlined pill -->
  <Style Selector="Button.sky.sky-outlined, Button.spotify.spotify-outlined">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkyBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.sky.sky-outlined:pointerover, Button.spotify.spotify-outlined:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkyListHoverBrush}" />
  </Style>

  <!-- Light pill (marketing / rare) -->
  <Style Selector="Button.sky.sky-light, Button.spotify.spotify-light">
    <Setter Property="Background" Value="{DynamicResource SkyLightPillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyLightPillTextBrush}" />
  </Style>

  <!-- Text-style (minimal) on dark -->
  <Style Selector="Button.sky.sky-subtle, Button.spotify.spotify-subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.sky.sky-subtle:pointerover, Button.spotify.spotify-subtle:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkyListHoverBrush}" />
  </Style>

  <!-- Circular play-style control -->
  <Style Selector="Button.sky.sky-play, Button.spotify.spotify-play">
    <Setter Property="Background" Value="{DynamicResource SkyAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyOnAccentBrush}" />
    <Setter Property="Padding" Value="{DynamicResource SkyDensityPlayPadding}" />
    <Setter Property="MinWidth" Value="{DynamicResource SkyDensityPlaySize}" />
    <Setter Property="MinHeight" Value="{DynamicResource SkyDensityPlaySize}" />
    <Setter Property="Width" Value="{DynamicResource SkyDensityPlaySize}" />
    <Setter Property="Height" Value="{DynamicResource SkyDensityPlaySize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusFull}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.sky.sky-play:pointerover, Button.spotify.spotify-play:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkyAccentPressedBrush}" />
  </Style>

  <Style Selector="Button.sky.sky-primary icons|SkyIcon, Button.spotify.spotify-primary icons|SkyIcon">
    <Setter Property="Foreground" Value="{DynamicResource SkyOnAccentBrush}" />
  </Style>
  <Style Selector="Button.sky.sky-play icons|SkyIcon, Button.spotify.spotify-play icons|SkyIcon">
    <Setter Property="Foreground" Value="{DynamicResource SkyOnAccentBrush}" />
  </Style>

  <Style Selector="Button.sky:disabled, Button.spotify:disabled">
    <Setter Property="Opacity" Value="{DynamicResource SkyDisabledOpacity}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.sky.sky-outlined:disabled, Button.spotify.spotify-outlined:disabled">
    <Setter Property="Opacity" Value="{DynamicResource SkyDisabledOpacity}" />
  </Style>

  <!-- Search / text field — pill surface -->
  <Style Selector="TextBox.sky, TextBox.spotify">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusPill}" />
    <Setter Property="Padding" Value="{DynamicResource SkyDensityFieldPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource SkyDensityFieldMinHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource SkyFontSizeButton}" />
    <Setter Property="FontFamily" Value="{DynamicResource SkyFontFamilyUi}" />
    <Setter Property="CaretBrush" Value="{DynamicResource SkyAccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SkySelectedTintBrush}" />
  </Style>
  <Style Selector="TextBox.sky:pointerover, TextBox.spotify:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource SkyBorderStrongBrush}" />
  </Style>
  <Style Selector="TextBox.sky:focus, TextBox.spotify:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource SkyAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox.sky:disabled, TextBox.spotify:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SkyDisabledForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkyDisabledBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource SkySurfaceBrush}" />
  </Style>
  <Style Selector="TextBox.sky.sky-search, TextBox.spotify.sky-search">
    <Setter Property="Padding" Value="44,12,14,12" />
  </Style>
  <Style Selector="TextBox.sky.sky-password, TextBox.spotify.sky-password">
    <Setter Property="Padding" Value="14,12,40,12" />
  </Style>

  <Style Selector="RadioButton.sky, RadioButton.spotify">
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource SkyFontSizeButton}" />
    <Setter Property="FontFamily" Value="{DynamicResource SkyFontFamilyUi}" />
    <Setter Property="Padding" Value="4,6" />
  </Style>
  <Style Selector="RadioButton.sky:disabled, RadioButton.spotify:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SkyDisabledForegroundBrush}" />
  </Style>

  <Style Selector="Slider.sky, Slider.spotify">
    <Setter Property="Foreground" Value="{DynamicResource SkyAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource SkySurfaceElevatedBrush}" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Slider.sky:disabled, Slider.spotify:disabled">
    <Setter Property="Opacity" Value="{DynamicResource SkyDisabledOpacity}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyDisabledForegroundBrush}" />
  </Style>

  <Style Selector="CheckBox.sky, CheckBox.spotify">
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource SkyFontSizeButton}" />
    <Setter Property="FontFamily" Value="{DynamicResource SkyFontFamilyUi}" />
  </Style>
  <Style Selector="CheckBox.sky:checked, CheckBox.spotify:checked">
    <Setter Property="Foreground" Value="{DynamicResource SkyAccentBrush}" />
  </Style>
  <Style Selector="CheckBox.sky:disabled, CheckBox.spotify:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SkyDisabledForegroundBrush}" />
  </Style>

  <Style Selector="ToggleSwitch.sky, ToggleSwitch.spotify">
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SkyFontFamilyUi}" />
    <Setter Property="FontSize" Value="{DynamicResource SkyFontSizeButton}" />
    <Setter Property="MinHeight" Value="{DynamicResource SkyDensityToggleMinHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleSwitch.sky:checked, ToggleSwitch.spotify:checked">
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
  </Style>
  <Style Selector="ToggleSwitch.sky:disabled, ToggleSwitch.spotify:disabled">
    <Setter Property="Opacity" Value="{DynamicResource SkyDisabledOpacity}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyDisabledForegroundBrush}" />
  </Style>
  <Style Selector="ToggleSwitch.sky /template/ Border#SwitchTrack">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleSwitch.sky:checked /template/ Border#SwitchTrack">
    <Setter Property="Background" Value="{DynamicResource SkyAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkyAccentBrush}" />
  </Style>
  <Style Selector="ToggleSwitch.sky /template/ Border#SwitchKnob">
    <Setter Property="Background" Value="{DynamicResource SkyTextPrimaryBrush}" />
  </Style>

  <Style Selector="ComboBox.sky, ComboBox.spotify">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusPill}" />
    <Setter Property="Padding" Value="{DynamicResource SkyDensityComboPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource SkyDensityComboMinHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource SkyFontSizeButton}" />
    <Setter Property="FontFamily" Value="{DynamicResource SkyFontFamilyUi}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox.sky:pointerover, ComboBox.spotify:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource SkyBorderStrongBrush}" />
  </Style>
  <Style Selector="ComboBox.sky:focus, ComboBox.spotify:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource SkyAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ComboBox.sky:disabled, ComboBox.spotify:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SkyDisabledForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkyDisabledBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource SkySurfaceBrush}" />
  </Style>

  <Style Selector="ComboBox.sky /template/ Popup, ComboBox.spotify /template/ Popup">
    <Setter Property="MaxHeight" Value="320" />
  </Style>
  <Style Selector="ComboBox.sky /template/ Border#PopupBorder, ComboBox.spotify /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusComfortable}" />
    <Setter Property="BoxShadow" Value="{DynamicResource SkyElevation2}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusStandard}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontFamily" Value="{DynamicResource SkyFontFamilyUi}" />
    <Setter Property="FontSize" Value="{DynamicResource SkyFontSizeButton}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkyListHoverBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource SkySelectedTintBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="ListBox.sky, ListBox.spotify">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusComfortable}" />
    <Setter Property="Padding" Value="{DynamicResource SkyDensityListBoxPadding}" />
    <Setter Property="FontSize" Value="{DynamicResource SkyFontSizeButton}" />
    <Setter Property="FontFamily" Value="{DynamicResource SkyFontFamilyUi}" />
  </Style>
  <Style Selector="ListBox.sky ListBoxItem, ListBox.spotify ListBoxItem">
    <Setter Property="Padding" Value="{DynamicResource SkyDensityListItemPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusStandard}" />
    <Setter Property="MinHeight" Value="{DynamicResource SkyDensityListItemMinHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontWeight" Value="Regular" />
  </Style>
  <Style Selector="ListBox.sky ListBoxItem:pointerover:not(:selected), ListBox.spotify ListBoxItem:pointerover:not(:selected)">
    <Setter Property="Background" Value="{DynamicResource SkyListHoverBrush}" />
  </Style>
  <Style Selector="ListBox.sky ListBoxItem:selected, ListBox.spotify ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource SkySelectedBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SkySelectedTintBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.sky ListBoxItem:disabled, ListBox.spotify ListBoxItem:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SkyDisabledForegroundBrush}" />
  </Style>

  <!-- Sidebar nav: inactive silver, active white bold -->
  <Style Selector="ListBox.sky-nav, ListBox.spotify-nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource SkyFontSizeButton}" />
    <Setter Property="FontFamily" Value="{DynamicResource SkyFontFamilyUi}" />
  </Style>
  <Style Selector="ListBox.sky-nav ListBoxItem, ListBox.spotify-nav ListBoxItem">
    <Setter Property="Padding" Value="{DynamicResource SkyDensityNavItemPadding}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SkyTextSecondaryBrush}" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.sky-nav ListBoxItem:pointerover:not(:selected), ListBox.spotify-nav ListBoxItem:pointerover:not(:selected)">
    <Setter Property="Background" Value="{DynamicResource SkyListHoverBrush}" />
  </Style>
  <Style Selector="ListBox.sky-nav ListBoxItem:selected, ListBox.spotify-nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource SkySelectedTintBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sky-nav ListBoxItem:selected TextBlock.sky-nav-link, ListBox.spotify-nav ListBoxItem:selected TextBlock.sky-nav-link">
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.sky-nav ListBoxItem TextBlock.sky-nav-link, ListBox.spotify-nav ListBoxItem TextBlock.sky-nav-link">
    <Setter Property="Foreground" Value="{DynamicResource SkyTextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.sky-nav ListBoxItem icons|SkyIcon, ListBox.spotify-nav ListBoxItem icons|SkyIcon">
    <Setter Property="Foreground" Value="{DynamicResource SkyTextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.sky-nav ListBoxItem:selected icons|SkyIcon, ListBox.spotify-nav ListBoxItem:selected icons|SkyIcon">
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
  </Style>

  <!-- Card container -->
  <Style Selector="Border.sky-card, Border.spotify-card">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusComfortable}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="{DynamicResource SkyElevation1}" />
  </Style>
  <Style Selector="Border.sky-card:pointerover, Border.spotify-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceElevatedBrush}" />
  </Style>

  <!-- Typography helpers moved to SkyUI.Fonts/Themes/SkyTypographyStyles.axaml -->

  <Style Selector="ProgressBar.sky, ProgressBar.spotify">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SkyAccentBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusFull}" />
    <Setter Property="MinHeight" Value="8" />
  </Style>
  <Style Selector="ProgressBar.sky:disabled, ProgressBar.spotify:disabled">
    <Setter Property="Opacity" Value="{DynamicResource SkyDisabledOpacity}" />
  </Style>

  <!-- Demo / docs sample panels -->
  <Style Selector="Border.sky-demo-panel">
    <Setter Property="Background" Value="{DynamicResource SkySurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SkyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource SkyRadiusComfortable}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BoxShadow" Value="{DynamicResource SkyElevation0}" />
  </Style>
</Styles>
