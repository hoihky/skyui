<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:SkyUI.Controls"
                    xmlns:icons="using:SkyUI.Icons">
  <ControlTheme x:Key="{x:Type controls:SkySafeArea}" TargetType="controls:SkySafeArea">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyKeyboardInset}" TargetType="controls:SkyKeyboardInset">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyFab}" TargetType="controls:SkyFab">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Template">
      <ControlTemplate>
        <Button x:Name="PART_ActionButton"
                Classes="sky sky-fab-button"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="0">
          <StackPanel Orientation="Horizontal"
                      Spacing="10"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <icons:SkyIcon Kind="{TemplateBinding Icon}"
                           Size="Large"
                           VerticalAlignment="Center" />
            <TextBlock Text="{TemplateBinding Label}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       IsVisible="{TemplateBinding IsExtended}" />
          </StackPanel>
        </Button>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyPullToRefresh}" TargetType="controls:SkyPullToRefresh">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="True">
          <Border x:Name="PART_Indicator"
                  Height="{TemplateBinding IndicatorHeight}"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Center"
                  Margin="0,8,0,0"
                  Opacity="0"
                  IsHitTestVisible="False">
            <controls:SkyProgressRing x:Name="PART_Progress"
                                      Width="28"
                                      Height="28"
                                      IsIndeterminate="{TemplateBinding IsRefreshing}" />
          </Border>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
