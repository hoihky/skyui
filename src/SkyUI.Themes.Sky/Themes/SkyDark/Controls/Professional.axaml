<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:SkyUI.Controls.Professional">
  <LinearGradientBrush x:Key="SkyColorPickerSpectrumBrush" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="#FFFF0000" Offset="0" />
    <GradientStop Color="#FFFFFF00" Offset="0.17" />
    <GradientStop Color="#FF00FF00" Offset="0.33" />
    <GradientStop Color="#FF00FFFF" Offset="0.5" />
    <GradientStop Color="#FF0000FF" Offset="0.67" />
    <GradientStop Color="#FFFF00FF" Offset="0.83" />
    <GradientStop Color="#FFFF0000" Offset="1" />
  </LinearGradientBrush>

  <ControlTheme x:Key="{x:Type controls:SkyPropertyGrid}" TargetType="controls:SkyPropertyGrid">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="sky-card" Padding="12" ClipToBounds="True" CornerRadius="8">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="PART_CategoriesHost" Spacing="0" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyColorPicker}" TargetType="controls:SkyColorPicker">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border Name="PART_Preview" Width="40" Height="40" CornerRadius="6"
                    BorderBrush="{DynamicResource SkyBorderBrush}" BorderThickness="1" Cursor="Hand" />
            <Border Name="PART_Spectrum" Grid.Column="1" Height="96" CornerRadius="6"
                    Background="{StaticResource SkyColorPickerSpectrumBrush}" Cursor="Hand" />
          </Grid>
          <TextBox Name="PART_HexBox" Classes="sky"
                   IsVisible="{TemplateBinding ShowHexInput}"
                   PlaceholderText="#RRGGBB" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyImageViewer}" TargetType="controls:SkyImageViewer">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="sky-card" Padding="4">
          <ScrollViewer Name="PART_Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image Name="PART_Image" Source="{TemplateBinding Source}" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyTreeView}" TargetType="controls:SkyTreeView">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="sky-card" Padding="6">
          <StackPanel Name="PART_ItemsHost" Spacing="0" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyTagEditor}" TargetType="controls:SkyTagEditor">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="sky-card" Padding="10">
          <StackPanel Spacing="8">
            <WrapPanel Name="PART_TagsHost" />
            <TextBox Name="PART_Input" Classes="sky" PlaceholderText="{TemplateBinding PlaceholderText}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyDualRangeSlider}" TargetType="controls:SkyDualRangeSlider">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="PART_Track" Height="32" Margin="8,0">
          <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                  Background="{DynamicResource SkyBorderBrush}" />
          <Border Name="PART_Fill" Height="4" VerticalAlignment="Center" CornerRadius="2"
                  Background="{DynamicResource SkyAccentBrush}" HorizontalAlignment="Stretch" />
          <Border Name="PART_StartThumb" Width="16" Height="16" CornerRadius="8"
                  VerticalAlignment="Center" HorizontalAlignment="Left"
                  Background="{DynamicResource SkyTextPrimaryBrush}"
                  BorderBrush="{DynamicResource SkyAccentBrush}" BorderThickness="2" />
          <Border Name="PART_EndThumb" Width="16" Height="16" CornerRadius="8"
                  VerticalAlignment="Center" HorizontalAlignment="Left"
                  Background="{DynamicResource SkyTextPrimaryBrush}"
                  BorderBrush="{DynamicResource SkyAccentBrush}" BorderThickness="2" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyRichTextBox}" TargetType="controls:SkyRichTextBox">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="sky-card" Padding="10">
          <StackPanel Spacing="8">
            <StackPanel Name="PART_Toolbar" Orientation="Horizontal" Spacing="6"
                        IsVisible="{TemplateBinding ShowToolbar}" />
            <TextBox Name="PART_Editor" Classes="sky" AcceptsReturn="True"
                     MinHeight="120" TextWrapping="Wrap" />
            <StackPanel Spacing="4" IsVisible="{TemplateBinding ShowLivePreview}">
              <TextBlock Classes="sky-body-secondary" Text="Preview" />
              <Border Padding="10" CornerRadius="6"
                      BorderBrush="{DynamicResource SkyBorderBrush}" BorderThickness="1"
                      Background="{DynamicResource SkySurfaceElevatedBrush}">
                <TextBlock Name="PART_Preview" TextWrapping="Wrap" MinHeight="72"
                           Classes="sky-body-secondary" />
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyStepper}" TargetType="controls:SkyStepper">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="sky-card" Padding="12">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Name="PART_StepsHost" Orientation="Horizontal" Spacing="0" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyDockPanel}" TargetType="controls:SkyDockPanel">
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="sky-dock-zone" Padding="0" ClipToBounds="True"
                BorderBrush="{DynamicResource SkyBorderBrush}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="sky-dock-tab-strip" Padding="8,6,8,0"
                    BorderBrush="{DynamicResource SkyBorderBrush}" BorderThickness="0,0,0,1">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Name="PART_TabStrip" Orientation="Horizontal" Spacing="2" />
              </ScrollViewer>
            </Border>
            <Grid Grid.Row="1" Classes="sky-dock-content-host">
              <ContentPresenter Name="PART_ContentHost" Margin="10" />
              <controls:SkyDockResizeGrip Name="PART_ResizeGrip" />
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyDockFloatWindow}" TargetType="controls:SkyDockFloatWindow">
    <Setter Property="MinWidth" Value="240" />
    <Setter Property="MinHeight" Value="160" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="sky-card sky-dock-float-window" Padding="0" ClipToBounds="True"
                BoxShadow="{DynamicResource SkyElevation2}"
                BorderBrush="{DynamicResource SkyBorderStrongBrush}" BorderThickness="1">
          <Grid RowDefinitions="Auto,*">
            <Grid Name="PART_TitleBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto"
                  Classes="sky-dock-float-titlebar"
                  ColumnSpacing="4" Margin="0,0,0,1">
              <Border Grid.Column="0" Width="4" Height="16" Margin="10,0,0,0"
                      VerticalAlignment="Center" CornerRadius="2"
                      Background="{DynamicResource SkySelectedBorderBrush}" Opacity="0.85" />
              <TextBlock Name="PART_TitleText" Grid.Column="1" Margin="8,8,4,8"
                         Classes="sky-section-title" VerticalAlignment="Center" />
              <Button Name="PART_Dock" Grid.Column="2" Classes="sky sky-subtle sky-dock-chrome-button"
                      Content="⧉" ToolTip.Tip="Dock to previous zone" MinWidth="28" MinHeight="28" Padding="4" />
              <Button Name="PART_Close" Grid.Column="3" Classes="sky sky-subtle sky-dock-chrome-button"
                      Content="×" ToolTip.Tip="Close" MinWidth="28" MinHeight="28" Padding="4" />
            </Grid>
            <Border Grid.Row="1" Classes="sky-dock-float-body" Padding="0">
              <ContentPresenter Name="PART_ContentHost" Margin="10" />
            </Border>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyDockManager}" TargetType="controls:SkyDockManager">
    <Setter Property="MinHeight" Value="280" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="sky-dock-shell" Padding="0" ClipToBounds="True"
                Background="{DynamicResource SkySurfaceBrush}"
                BorderBrush="{DynamicResource SkyBorderBrush}" BorderThickness="1">
          <Grid Name="PART_Root" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                  RowDefinitions="Auto,*" RowSpacing="2"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
              <controls:SkyDocumentWell Name="PART_LeftDocumentZone" Grid.Row="0"
                                        ShellPlacementFilter="Left" IsVisible="False"
                                        MinHeight="120" MaxHeight="280"
                                        VerticalAlignment="Top"
                                        ItemsSource="{TemplateBinding Documents}"
                                        SelectedDocument="{TemplateBinding SelectedDocument, Mode=TwoWay}" />
              <controls:SkyDockPanel Name="PART_LeftPanel" Grid.Row="1"
                                   Zone="Left"
                                   VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="*">
              <controls:SkyDocumentWell Name="PART_DocumentWell" Grid.Row="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        ItemsSource="{TemplateBinding Documents}"
                                        SelectedDocument="{TemplateBinding SelectedDocument, Mode=TwoWay}" />
            </Grid>
            <Canvas Name="PART_FloatCanvas"
                    Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="3"
                    Panel.ZIndex="150"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    IsHitTestVisible="True" />
            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                  RowDefinitions="Auto,*" RowSpacing="2"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
              <controls:SkyDocumentWell Name="PART_RightDocumentZone" Grid.Row="0"
                                        ShellPlacementFilter="Right" IsVisible="False"
                                        MinHeight="120" MaxHeight="280"
                                        VerticalAlignment="Top"
                                        ItemsSource="{TemplateBinding Documents}"
                                        SelectedDocument="{TemplateBinding SelectedDocument, Mode=TwoWay}" />
              <controls:SkyDockPanel Name="PART_RightPanel" Grid.Row="1"
                                   Zone="Right"
                                   VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="2"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
              <controls:SkyDocumentWell Name="PART_BottomDocumentZone" Grid.Row="0"
                                        ShellPlacementFilter="Bottom" IsVisible="False"
                                        MinHeight="100" MaxHeight="240"
                                        VerticalAlignment="Top"
                                        ItemsSource="{TemplateBinding Documents}"
                                        SelectedDocument="{TemplateBinding SelectedDocument, Mode=TwoWay}" />
              <controls:SkyDockPanel Name="PART_BottomPanel" Grid.Row="1" Zone="Bottom"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>
            <Panel Name="PART_DropOverlay" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="3"
                   IsVisible="False" IsHitTestVisible="False" ZIndex="200"
                   Background="#66000000">
            <Border Name="PART_DropLeft" Classes="sky-dock-drop-target" HorizontalAlignment="Left"
                    Width="112" Margin="8" VerticalAlignment="Stretch">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Classes="sky-dock-drop-glyph" Text="◧" />
                <TextBlock Classes="sky-caption" Text="Dock left" />
              </StackPanel>
            </Border>
            <Border Name="PART_DropRight" Classes="sky-dock-drop-target" HorizontalAlignment="Right"
                    Width="112" Margin="8" VerticalAlignment="Stretch">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Classes="sky-dock-drop-glyph" Text="◨" />
                <TextBlock Classes="sky-caption" Text="Dock right" />
              </StackPanel>
            </Border>
            <Border Name="PART_DropBottom" Classes="sky-dock-drop-target" VerticalAlignment="Bottom"
                    Height="88" Margin="8" HorizontalAlignment="Stretch">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Classes="sky-dock-drop-glyph" Text="▬" />
                <TextBlock Classes="sky-caption" Text="Dock bottom" />
              </StackPanel>
            </Border>
            <Border Name="PART_DropFloat" Classes="sky-dock-drop-target" HorizontalAlignment="Center"
                    VerticalAlignment="Center" MinWidth="220" MinHeight="120" Margin="8" Padding="16">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Classes="sky-dock-drop-glyph" Text="⬚" />
                <TextBlock Classes="sky-caption" Text="Float" />
                <TextBlock Classes="sky-body-secondary" Text="Center of document area"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="180" />
              </StackPanel>
            </Border>
          </Panel>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyDocumentWell}" TargetType="controls:SkyDocumentWell">
    <Setter Property="MinHeight" Value="200" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="sky-card sky-document-well-chrome" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="sky-dock-tab-strip" Padding="8,6,8,0"
                    BorderBrush="{DynamicResource SkyBorderBrush}" BorderThickness="0,0,0,1">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Name="PART_TabStrip" Orientation="Horizontal" Spacing="4" />
              </ScrollViewer>
            </Border>
            <ContentPresenter Name="PART_ContentHost" Grid.Row="1" Margin="12" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SkyWizard}" TargetType="controls:SkyWizard">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="sky-card" Padding="16">
          <Grid RowDefinitions="*,Auto" RowSpacing="12">
            <ContentPresenter Name="PART_PageHost" Grid.Row="0" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Name="PART_Back" Classes="sky" Content="Back" />
              <Button Name="PART_Next" Classes="sky sky-primary" Content="Next" />
            </StackPanel>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
