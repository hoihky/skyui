<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:SkyUI.Controls">
  <ControlTheme x:Key="{x:Type controls:SkyTooltip}"
                TargetType="controls:SkyTooltip"
                BasedOn="{StaticResource {x:Type ToolTip}}" />

  <ControlTheme x:Key="{x:Type controls:SkyPopover}"
                TargetType="controls:SkyPopover"
                BasedOn="{StaticResource {x:Type Flyout}}" />
</ResourceDictionary>
