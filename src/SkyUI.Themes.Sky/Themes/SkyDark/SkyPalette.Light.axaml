<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Sky Aurora — light: soft lavender canvas, rich violet accent -->
  <Color x:Key="SkyPaletteBackground">#F3F0FF</Color>
  <Color x:Key="SkyPaletteSurface">#FFFFFF</Color>
  <Color x:Key="SkyPaletteSurfaceElevated">#F8F6FF</Color>
  <Color x:Key="SkyPaletteCard">#FFFFFF</Color>
  <Color x:Key="SkyPaletteCardMid">#EDE9FE</Color>
  <Color x:Key="SkyPaletteTextPrimary">#130F26</Color>
  <Color x:Key="SkyPaletteTextSecondary">#5B5475</Color>
  <Color x:Key="SkyPaletteTextSecondaryBright">#3F3958</Color>
  <Color x:Key="SkyPaletteTextLight">#000000</Color>
  <Color x:Key="SkyPaletteAccent">#7C3AED</Color>
  <Color x:Key="SkyPaletteAccentPressed">#6D28D9</Color>
  <Color x:Key="SkyPaletteOnAccent">#FFFFFF</Color>
  <Color x:Key="SkyPaletteDanger">#E11D48</Color>
  <Color x:Key="SkyPaletteWarning">#EA580C</Color>
  <Color x:Key="SkyPaletteInfo">#0284C7</Color>
  <Color x:Key="SkyPaletteBorder">#8B80A8</Color>
  <Color x:Key="SkyPaletteBorderStrong">#5B5475</Color>
  <Color x:Key="SkyPaletteSeparator">#C4B5FD</Color>
  <Color x:Key="SkyPaletteLightPill">#EDE9FE</Color>
  <Color x:Key="SkyPaletteLightPillText">#130F26</Color>
  <Color x:Key="SkyPaletteHoverTint">#1A7C3AED</Color>
  <Color x:Key="SkyPaletteListHover">#1F7C3AED</Color>
  <Color x:Key="SkyPaletteSelectedTint">#407C3AED</Color>
  <Color x:Key="SkyPaletteSelectedBorder">#667C3AED</Color>
  <Color x:Key="SkyPaletteDisabledForeground">#9A94B0</Color>
  <Color x:Key="SkyPaletteDisabledBorder">#D8D2F0</Color>
  <Color x:Key="SkyPaletteAvatarFallback">#DDD6FE</Color>
  <Color x:Key="SkyPaletteBadgeNeutral">#EDE9FE</Color>
  <Color x:Key="SkyPaletteFocusRing">#7C3AED</Color>
  <Color x:Key="SkyPaletteScrim">#80000000</Color>
</ResourceDictionary>
