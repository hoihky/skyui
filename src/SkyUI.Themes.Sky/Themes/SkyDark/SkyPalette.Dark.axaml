<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Sky Dark preset: palette (content-first dark) → semantic tokens → legacy Spotify brush aliases. -->
  <Color x:Key="SkyPaletteBackground">#121212</Color>
  <Color x:Key="SkyPaletteSurface">#181818</Color>
  <Color x:Key="SkyPaletteSurfaceElevated">#212121</Color>
  <Color x:Key="SkyPaletteCard">#262626</Color>
  <Color x:Key="SkyPaletteCardMid">#2A2A2A</Color>
  <Color x:Key="SkyPaletteTextPrimary">#ffffff</Color>
  <Color x:Key="SkyPaletteTextSecondary">#b8b8b8</Color>
  <Color x:Key="SkyPaletteTextSecondaryBright">#d4d4d4</Color>
  <Color x:Key="SkyPaletteTextLight">#fdfdfd</Color>
  <Color x:Key="SkyPaletteAccent">#1ed760</Color>
  <Color x:Key="SkyPaletteAccentPressed">#1db954</Color>
  <Color x:Key="SkyPaletteOnAccent">#000000</Color>
  <Color x:Key="SkyPaletteDanger">#f3727f</Color>
  <Color x:Key="SkyPaletteWarning">#ffa42b</Color>
  <Color x:Key="SkyPaletteInfo">#539df5</Color>
  <Color x:Key="SkyPaletteBorder">#707070</Color>
  <Color x:Key="SkyPaletteBorderStrong">#8A8A8A</Color>
  <Color x:Key="SkyPaletteSeparator">#9A9A9A</Color>
  <Color x:Key="SkyPaletteLightPill">#eeeeee</Color>
  <Color x:Key="SkyPaletteLightPillText">#181818</Color>
  <Color x:Key="SkyPaletteHoverTint">#1FFFFFFF</Color>
  <Color x:Key="SkyPaletteListHover">#24FFFFFF</Color>
  <Color x:Key="SkyPaletteSelectedTint">#3A1ED760</Color>
  <Color x:Key="SkyPaletteSelectedBorder">#661ED760</Color>
  <Color x:Key="SkyPaletteDisabledForeground">#6E6E6E</Color>
  <Color x:Key="SkyPaletteDisabledBorder">#3A3A3A</Color>
  <Color x:Key="SkyPaletteAvatarFallback">#3e3e3e</Color>
  <Color x:Key="SkyPaletteBadgeNeutral">#2a2a2a</Color>
  <!-- Focus ring: accent green meets ≥3:1 on dark surfaces -->
  <Color x:Key="SkyPaletteFocusRing">#1ED760</Color>
  <Color x:Key="SkyPaletteScrim">#B3000000</Color>
</ResourceDictionary>
