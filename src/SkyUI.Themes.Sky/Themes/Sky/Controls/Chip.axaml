<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:SkyUI.Controls">
  <ControlTheme x:Key="{x:Type controls:Chip}" TargetType="controls:Chip">
    <Setter Property="Foreground" Value="{DynamicResource SkyTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SkyFontFamilyUi}" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                MinHeight="{TemplateBinding MinHeight}"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="9999"
                ClipToBounds="True"
                UseLayoutRounding="True">
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Spacing="0">
            <ContentPresenter Name="PART_AvatarHost"
                              Content="{TemplateBinding AvatarContent}"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"
                              IsVisible="False" />
            <TextBlock Name="PART_Label"
                       VerticalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="240" />
            <Button Name="PART_Delete"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0"
                    Padding="0"
                    MinWidth="24"
                    MinHeight="24"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{TemplateBinding Foreground}"
                    Opacity="0.7"
                    Cursor="Hand"
                    IsVisible="False"
                    Content="×"
                    FontSize="16"
                    FontWeight="Bold" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
