<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SkyUI/Themes/Spotify/SpotifyResources.axaml" />
        <ResourceInclude Source="avares://SkyUI/Themes/Spotify/Controls/Badge.axaml" />
        <ResourceInclude Source="avares://SkyUI/Themes/Spotify/Controls/Avatar.axaml" />
        <ResourceInclude Source="avares://SkyUI/Themes/Spotify/Controls/Chip.axaml" />
        <ResourceInclude Source="avares://SkyUI/Themes/Spotify/Controls/CheckedListBox.axaml" />
        <ResourceInclude Source="avares://SkyUI/Themes/Spotify/Controls/FilterEditor.axaml" />
        <ResourceInclude Source="avares://SkyUI/Themes/Spotify/Controls/SkyVirtualDataGrid.axaml" />
        <ResourceInclude Source="avares://SkyUI/Themes/Spotify/Controls/Accordion.axaml" />
        <ResourceInclude Source="avares://SkyUI/Themes/Spotify/Controls/VideoTimeline.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <StyleInclude Source="avares://SkyUI/Themes/Spotify/Controls/Accordion.Styles.axaml" />
  <StyleInclude Source="avares://SkyUI/Themes/Spotify/Controls/FilterEditor.Styles.axaml" />
  <StyleInclude Source="avares://SkyUI/Themes/Spotify/Controls/SkyVirtualDataGrid.Styles.axaml" />

  <!-- Dark pill (secondary) -->
  <Style Selector="Button.spotify">
    <Setter Property="Background" Value="{DynamicResource SpotifySurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="9999" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFamily" Value="{DynamicResource SpotifyFontUi}" />
  </Style>
  <Style Selector="Button.spotify:pointerover">
    <Setter Property="Background" Value="{DynamicResource SpotifyCardMidBrush}" />
  </Style>
  <Style Selector="Button.spotify:pressed">
    <Setter Property="Background" Value="{DynamicResource SpotifyCardBrush}" />
  </Style>
  <Style Selector="Button.spotify:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Primary CTA — Spotify green (functional accent) -->
  <Style Selector="Button.spotify.spotify-primary">
    <Setter Property="Background" Value="{DynamicResource SpotifyAccentGreenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyOnAccentBrush}" />
  </Style>
  <Style Selector="Button.spotify.spotify-primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource SpotifyAccentGreenDarkBrush}" />
  </Style>
  <Style Selector="Button.spotify.spotify-primary:pressed">
    <Setter Property="Background" Value="{DynamicResource SpotifyAccentGreenDarkBrush}" />
  </Style>

  <!-- Large nav pill -->
  <Style Selector="Button.spotify.spotify-nav-pill">
    <Setter Property="Background" Value="{DynamicResource SpotifySurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
    <Setter Property="Padding" Value="32,12" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="CornerRadius" Value="500" />
  </Style>
  <Style Selector="Button.spotify.spotify-nav-pill:pointerover">
    <Setter Property="Background" Value="{DynamicResource SpotifySurfaceElevatedBrush}" />
  </Style>

  <!-- Outlined pill -->
  <Style Selector="Button.spotify.spotify-outlined">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource SpotifyBorderLightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.spotify.spotify-outlined:pointerover">
    <Setter Property="Background" Value="{DynamicResource SpotifyListHoverBrush}" />
  </Style>

  <!-- Light pill (marketing / rare) -->
  <Style Selector="Button.spotify.spotify-light">
    <Setter Property="Background" Value="{DynamicResource SpotifyLightPillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyLightPillTextBrush}" />
  </Style>

  <!-- Text-style (minimal) on dark -->
  <Style Selector="Button.spotify.spotify-subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.spotify.spotify-subtle:pointerover">
    <Setter Property="Background" Value="{DynamicResource SpotifyListHoverBrush}" />
  </Style>

  <!-- Circular play-style control -->
  <Style Selector="Button.spotify.spotify-play">
    <Setter Property="Background" Value="{DynamicResource SpotifyAccentGreenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyOnAccentBrush}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="9999" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.spotify.spotify-play:pointerover">
    <Setter Property="Background" Value="{DynamicResource SpotifyAccentGreenDarkBrush}" />
  </Style>

  <Style Selector="Button.spotify.spotify-outlined:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Search / text field — pill surface -->
  <Style Selector="TextBox.spotify">
    <Setter Property="Background" Value="{DynamicResource SpotifySurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SpotifyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="500" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontFamily" Value="{DynamicResource SpotifyFontUi}" />
    <Setter Property="CaretBrush" Value="{DynamicResource SpotifyAccentGreenBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SpotifySelectedTintBrush}" />
  </Style>
  <Style Selector="TextBox.spotify:focus">
    <Setter Property="BorderBrush" Value="#000000" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.spotify:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="CheckBox.spotify">
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontFamily" Value="{DynamicResource SpotifyFontUi}" />
  </Style>
  <Style Selector="CheckBox.spotify:checked">
    <Setter Property="Foreground" Value="{DynamicResource SpotifyAccentGreenBrush}" />
  </Style>
  <Style Selector="CheckBox.spotify:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource SpotifyAccentGreenBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="CheckBox.spotify:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="ToggleSwitch.spotify">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="OnContent" Value="" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleSwitch.spotify:checked">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyAccentGreenBrush}" />
  </Style>
  <Style Selector="ToggleSwitch.spotify:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource SpotifyAccentGreenBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="ToggleSwitch.spotify:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="ComboBox.spotify">
    <Setter Property="Background" Value="{DynamicResource SpotifySurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SpotifyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="500" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontFamily" Value="{DynamicResource SpotifyFontUi}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox.spotify:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource SpotifyAccentGreenBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBox.spotify:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource SpotifyBorderLightBrush}" />
  </Style>
  <Style Selector="ComboBox.spotify:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="ListBox.spotify">
    <Setter Property="Background" Value="{DynamicResource SpotifySurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontFamily" Value="{DynamicResource SpotifyFontUi}" />
  </Style>
  <Style Selector="ListBox.spotify:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource SpotifyAccentGreenBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.spotify ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontWeight" Value="Regular" />
  </Style>
  <Style Selector="ListBox.spotify ListBoxItem:pointerover:not(:selected)">
    <Setter Property="Background" Value="{DynamicResource SpotifyListHoverBrush}" />
  </Style>
  <Style Selector="ListBox.spotify ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource SpotifyAccentGreenBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="ListBox.spotify ListBoxItem:focus:not(:selected)">
    <Setter Property="BorderBrush" Value="{DynamicResource SpotifyAccentGreenBrush}" />
  </Style>
  <Style Selector="ListBox.spotify ListBoxItem:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Sidebar nav: inactive silver, active white bold -->
  <Style Selector="ListBox.spotify-nav">
    <Setter Property="Background" Value="{DynamicResource SpotifyBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontFamily" Value="{DynamicResource SpotifyFontUi}" />
  </Style>
  <Style Selector="ListBox.spotify-nav ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextSecondaryBrush}" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.spotify-nav ListBoxItem:pointerover:not(:selected)">
    <Setter Property="Background" Value="{DynamicResource SpotifyListHoverBrush}" />
  </Style>
  <Style Selector="ListBox.spotify-nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="{DynamicResource SpotifyListHoverBrush}" />
  </Style>

  <!-- Card container -->
  <Style Selector="Border.spotify-card">
    <Setter Property="Background" Value="{DynamicResource SpotifySurfaceBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 8 8 0 #4D000000" />
  </Style>
  <Style Selector="Border.spotify-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource SpotifySurfaceElevatedBrush}" />
  </Style>

  <!-- Typography helpers -->
  <Style Selector="TextBlock.spotify-section-title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SpotifyFontTitle}" />
  </Style>
  <Style Selector="TextBlock.spotify-feature-heading">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SpotifyFontUi}" />
  </Style>
  <Style Selector="TextBlock.spotify-body-secondary">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyTextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SpotifyFontUi}" />
  </Style>

  <Style Selector="ProgressBar.spotify">
    <Setter Property="Background" Value="{DynamicResource SpotifySurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SpotifyAccentGreenBrush}" />
    <Setter Property="CornerRadius" Value="9999" />
    <Setter Property="MinHeight" Value="8" />
  </Style>
  <Style Selector="ProgressBar.spotify:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
</Styles>
