<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0</TargetFrameworks>
    <RootNamespace>SkyUI.Core</RootNamespace>
    <AssemblyName>SkyUI.Core</AssemblyName>
    <Description>SkyUI design tokens, shared contracts, and theme attached properties.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>SkyUI.Core</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkyUI.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\SkyDensityTokens.axaml" />
    <AvaloniaResource Include="Themes\SkyTokens.axaml" />
  </ItemGroup>

</Project>
