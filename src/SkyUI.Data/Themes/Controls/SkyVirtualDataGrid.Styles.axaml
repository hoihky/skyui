<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="using:SkyUI.DataGrid">
  <Style Selector="dg|SkyVirtualDataGrid">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="dg|SkyVirtualDataGrid Grid.sky-grid-row">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="dg|SkyVirtualDataGrid Grid.sky-grid-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkyListHoverBrush}" />
  </Style>
  <Style Selector="dg|SkyVirtualDataGrid Grid.sky-grid-row.sky-grid-row-selected">
    <Setter Property="Background" Value="{DynamicResource SkySelectedTintBrush}" />
  </Style>
  <Style Selector="dg|SkyVirtualDataGrid Grid.sky-grid-row.sky-grid-row-selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource SkyHoverTintBrush}" />
  </Style>
  <Style Selector="dg|SkyVirtualDataGrid Grid.sky-grid-milestone">
    <Setter Property="Background" Value="#402040" />
  </Style>
</Styles>
