<Project>
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <Version>0.1.0-local</Version>
    <PackageVersion>0.1.0-local</PackageVersion>
    <Authors>hoihky</Authors>
    <Company>SkyUI</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/hoihky/skyui</RepositoryUrl>
    <PackageProjectUrl>https://github.com/hoihky/skyui</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
